VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Build server only. Never prefix these with VITE_.
# Required by yarn build:deploy; keep the personal API key in the hosting secret store.
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=
