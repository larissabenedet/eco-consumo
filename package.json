{
  "name": "eco-consumo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src tests playwright.config.js --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:deploy": "node scripts/build-deploy.mjs",
    "test": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual --workers=1",
    "test:visual:update": "playwright test --grep @visual --update-snapshots --workers=1",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "posthog-js": "1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-slick": "^0.29.0",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@posthog/cli": "^0.20.1",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "styled-components": "^5.3.11",
    "vite": "^4.3.9"
  }
}
